{
  "manifest_version": 3,
  "name": "Smart Clipboard Form Filler",
  "version": "1.0.0",
  "description": "Autofills web forms from chat history or clipboard text using smart fuzzy matching.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Clipboard Form Filler"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
